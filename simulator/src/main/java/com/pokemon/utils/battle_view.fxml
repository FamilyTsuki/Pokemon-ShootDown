<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pokemon.controllers.BattleController"
      prefHeight="600.0" prefWidth="800.0" spacing="10" style="-fx-background-color: #2c3e50;">

    <HBox prefHeight="350.0" spacing="50" alignment="CENTER">
        <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
        
        <VBox alignment="BOTTOM_CENTER" spacing="5">
            <Label fx:id="playerNameLabel" text="Nom Pokémon" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <ProgressBar fx:id="playerHPBar" prefWidth="150" progress="1.0" style="-fx-accent: green;"/>
            <Label fx:id="playerHPText" text="100/100" style="-fx-text-fill: white;"/>
            <ImageView fx:id="playerSprite" fitHeight="150" fitWidth="150" pickOnBounds="true" preserveRatio="true"/>
        </VBox>

        <TextArea fx:id="battleLog" editable="false" prefWidth="300" wrapText="true" 
                  style="-fx-control-inner-background: #34495e; -fx-text-fill: white;"/>

        <VBox alignment="TOP_CENTER" spacing="5">
            <ImageView fx:id="cpuSprite" fitHeight="150" fitWidth="150" pickOnBounds="true" preserveRatio="true"/>
            <Label fx:id="cpuNameLabel" text="CPU Pokémon" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <ProgressBar fx:id="cpuHPBar" prefWidth="150" progress="1.0" style="-fx-accent: red;"/>
        </VBox>
    </HBox>

    <Separator/>

    <HBox spacing="20" alignment="CENTER" prefHeight="200.0">
        <padding><Insets bottom="20"/></padding>

        <GridPane hgap="10" vgap="10">
            <Button fx:id="move1" prefWidth="120" prefHeight="50" onAction="#handleMove" text="Attaque 1"/>
            <Button fx:id="move2" prefWidth="120" prefHeight="50" onAction="#handleMove" text="Attaque 2" GridPane.columnIndex="1"/>
            <Button fx:id="move3" prefWidth="120" prefHeight="50" onAction="#handleMove" text="Attaque 3" GridPane.rowIndex="1"/>
            <Button fx:id="move4" prefWidth="120" prefHeight="50" onAction="#handleMove" text="Attaque 4" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <VBox spacing="10">
            <Button text="Switch Pokémon" onAction="#handleSwitch" prefWidth="150" style="-fx-background-color: #f39c12;"/>
            <Button text="Méga-Évolution" onAction="#handleMega" prefWidth="150" style="-fx-background-color: #9b59b6;"/>
            <Button text="Sac (Objets)" onAction="#handleItems" prefWidth="150" style="-fx-background-color: #3498db;"/>
        </VBox>
    </HBox>
</VBox>