<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pokemon.controllers.PokemonEditorController">
    <children>
        <Label fx:id="pokemonNameLabel" text="Nom du Pokémon">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="40.0">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <ImageView fx:id="pokemonSprite" fitHeight="160.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
                    <Label text="Item / Objet" style="-fx-font-weight: bold;" />
                    <ComboBox fx:id="itemComboBox" prefWidth="150.0" promptText="Select Item" />
                </VBox>

                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="5.0">
                            <Label text="Move 1" />
                            <ComboBox fx:id="move1" prefWidth="150.0" />
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1">
                            <Label text="Move 2" />
                            <ComboBox fx:id="move2" prefWidth="150.0" />
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="1">
                            <Label text="Move 3" />
                            <ComboBox fx:id="move3" prefWidth="150.0" />
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Move 4" />
                            <ComboBox fx:id="move4" prefWidth="150.0" />
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </HBox>

        <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="45.0" prefWidth="250.0" 
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="VALIDER ET AJOUTER" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>