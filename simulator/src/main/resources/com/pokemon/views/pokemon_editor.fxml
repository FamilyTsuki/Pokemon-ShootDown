<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="600.0" spacing="20.0" 
      styleClass="root" xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pokemon.controllers.PokemonEditorController">
    
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <children>
        <Label fx:id="pokemonNameLabel" text="Nom du Pokémon" styleClass="title-label" />

        <HBox alignment="CENTER" spacing="40.0">
            <children>
                <VBox alignment="CENTER" spacing="15.0" styleClass="editor-card">
                    <ImageView fx:id="pokemonSprite" fitHeight="160.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true" />
                    
                    <VBox alignment="CENTER" spacing="5.0">
                        <Label text="OBJET TENU" styleClass="field-label" />
                        <ComboBox fx:id="itemComboBox" prefWidth="150.0" promptText="Select Item" styleClass="combo-box-styled" />
                    </VBox>
                </VBox>

                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="5.0">
                            <Label text="ATTAQUE 1" styleClass="field-label" />
                            <ComboBox fx:id="move1" prefWidth="150.0" styleClass="combo-box-styled" />
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1">
                            <Label text="ATTAQUE 2" styleClass="field-label" />
                            <ComboBox fx:id="move2" prefWidth="150.0" styleClass="combo-box-styled" />
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="1">
                            <Label text="ATTAQUE 3" styleClass="field-label" />
                            <ComboBox fx:id="move3" prefWidth="150.0" styleClass="combo-box-styled" />
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="ATTAQUE 4" styleClass="field-label" />
                            <ComboBox fx:id="move4" prefWidth="150.0" styleClass="combo-box-styled" />
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </HBox>

        <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="45.0" prefWidth="280.0" 
                styleClass="btn-primary" text="VALIDER ET AJOUTER" />
    </children>
    
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>