<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pokemon.controllers.TeamBuilderController"
      prefHeight="700.0" prefWidth="900.0" spacing="25" 
      styleClass="root" alignment="TOP_CENTER">

    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="5">
        <Label text="TEAM BUILDER" styleClass="title-label"/>
        <Label text="Sélectionnez vos 6 compagnons de combat" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;"/>
    </VBox>

    <GridPane hgap="30" vgap="30" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints prefWidth="220"/>
            <ColumnConstraints prefWidth="220"/>
            <ColumnConstraints prefWidth="220"/>
        </columnConstraints>

        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" alignment="CENTER" spacing="10" styleClass="pokemon-slot-container">
            <StackPane>
                <Button fx:id="slot1Btn" text="+" onAction="#handleSelectPokemon" styleClass="pokemon-slot"/>
                <Button fx:id="remove1Btn" text="×" onAction="#handleRemovePokemon" visible="false" 
                        StackPane.alignment="TOP_RIGHT" styleClass="btn-remove-small">
                    <StackPane.margin><Insets top="-10" right="-10"/></StackPane.margin>
                </Button>
            </StackPane>
            <Label text="SLOT 1" styleClass="field-label"/>
        </VBox>

        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER" spacing="10" styleClass="pokemon-slot-container">
            <StackPane>
                <Button fx:id="slot2Btn" text="+" onAction="#handleSelectPokemon" styleClass="pokemon-slot"/>
                <Button fx:id="remove2Btn" text="×" onAction="#handleRemovePokemon" visible="false" 
                        StackPane.alignment="TOP_RIGHT" styleClass="btn-remove-small">
                    <StackPane.margin><Insets top="-10" right="-10"/></StackPane.margin>
                </Button>
            </StackPane>
            <Label text="SLOT 2" styleClass="field-label"/>
        </VBox>

        <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" alignment="CENTER" spacing="10" styleClass="pokemon-slot-container">
            <StackPane>
                <Button fx:id="slot3Btn" text="+" onAction="#handleSelectPokemon" styleClass="pokemon-slot"/>
                <Button fx:id="remove3Btn" text="×" onAction="#handleRemovePokemon" visible="false" 
                        StackPane.alignment="TOP_RIGHT" styleClass="btn-remove-small">
                    <StackPane.margin><Insets top="-10" right="-10"/></StackPane.margin>
                </Button>
            </StackPane>
            <Label text="SLOT 3" styleClass="field-label"/>
        </VBox>

        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER" spacing="10" styleClass="pokemon-slot-container">
            <StackPane>
                <Button fx:id="slot4Btn" text="+" onAction="#handleSelectPokemon" styleClass="pokemon-slot"/>
                <Button fx:id="remove4Btn" text="×" onAction="#handleRemovePokemon" visible="false" 
                        StackPane.alignment="TOP_RIGHT" styleClass="btn-remove-small">
                    <StackPane.margin><Insets top="-10" right="-10"/></StackPane.margin>
                </Button>
            </StackPane>
            <Label text="SLOT 4" styleClass="field-label"/>
        </VBox>

        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="CENTER" spacing="10" styleClass="pokemon-slot-container">
            <StackPane>
                <Button fx:id="slot5Btn" text="+" onAction="#handleSelectPokemon" styleClass="pokemon-slot"/>
                <Button fx:id="remove5Btn" text="×" onAction="#handleRemovePokemon" visible="false" 
                        StackPane.alignment="TOP_RIGHT" styleClass="btn-remove-small">
                    <StackPane.margin><Insets top="-10" right="-10"/></StackPane.margin>
                </Button>
            </StackPane>
            <Label text="SLOT 5" styleClass="field-label"/>
        </VBox>

        <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" alignment="CENTER" spacing="10" styleClass="pokemon-slot-container">
            <StackPane>
                <Button fx:id="slot6Btn" text="+" onAction="#handleSelectPokemon" styleClass="pokemon-slot"/>
                <Button fx:id="remove6Btn" text="×" onAction="#handleRemovePokemon" visible="false" 
                        StackPane.alignment="TOP_RIGHT" styleClass="btn-remove-small">
                    <StackPane.margin><Insets top="-10" right="-10"/></StackPane.margin>
                </Button>
            </StackPane>
            <Label text="SLOT 6" styleClass="field-label"/>
        </VBox>
    </GridPane>

    <HBox spacing="40" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <Button text="RETOUR" onAction="#handleBack" styleClass="btn-secondary"/>
        <Button text="ALÉATOIRE" onAction="#handleRandomTeam" styleClass="btn-switch" prefWidth="150" prefHeight="40"/>
        <Button fx:id="startBtn" text="3 POKÉMON REQUIS" disable="true" onAction="#handleStartBattle" prefWidth="300" prefHeight="60" styleClass="btn-primary"/>
    </HBox>

</VBox>