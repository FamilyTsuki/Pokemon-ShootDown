<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx" 
           xmlns:fx="http://javafx.com/fxml" 
           fx:controller="com.pokemon.controllers.StartController"
           prefHeight="600.0" prefWidth="800.0" 
           styleClass="root">
    
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>

    <VBox alignment="CENTER" spacing="50">
        <VBox alignment="CENTER" spacing="10">
            <Label text="POKÉMON" styleClass="title-label" style="-fx-font-size: 60px;"/>
            <Label text="SHOOTDOWN" styleClass="title-label" style="-fx-text-fill: #ecf0f1; -fx-font-size: 40px;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="20">
            <Button text="COMMENCER LE COMBAT" 
                    onAction="#handleStart" 
                    prefWidth="300" prefHeight="70"
                    styleClass="btn-primary"/>

            <Button text="QUITTER LE JEU" 
                    onAction="#handleQuit" 
                    prefWidth="200" prefHeight="45"
                    styleClass="btn-secondary"/>
        </VBox>

        <Label text="Version 1.0 - Projet Simulation POO" 
               style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
    </VBox>
</StackPane>